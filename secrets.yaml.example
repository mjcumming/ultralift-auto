# Copy to secrets.yaml and fill in. secrets.yaml is gitignored — keep it that way.

# WiFi (the lift config uses network 1; the panel configs can use a second)
wifi_ssid_1: "your-ssid"
wifi_password_1: "your-wifi-password"
wifi_ssid_2: "your-second-ssid"
wifi_password_2: "your-second-wifi-password"

# Fallback AP password (captive portal when WiFi is down)
ap_password: "choose-a-password"

# Home Assistant native API encryption key (generate: https://esphome.io/components/api.html)
api_encryption_key: "generate-a-32-byte-base64-key"

# OTA update password — must match the firmware already on the device when re-flashing
ota_password: "choose-a-password"
